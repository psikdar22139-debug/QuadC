%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>

#define MAX_VARS 256

extern int yylex(void);
extern int line_no;
extern FILE *yyin;
void yyerror(const char *s);

/* ---- symbol table: every variable gets one memory cell ---- */
static char *names[MAX_VARS];
static int   nvars = 0;

static int addr_of(const char *name) {
    for (int i = 0; i < nvars; i++)
        if (strcmp(names[i], name) == 0) return i;
    if (nvars >= MAX_VARS) { fprintf(stderr, "too many variables\n"); exit(1); }
    names[nvars] = strdup(name);
    return nvars++;
}

/* ---- generated C body is collected in memory, header is written at the end ---- */
static char  *buf  = NULL;
static size_t blen = 0, bcap = 0;
static int count3 = 0, count4 = 0;

static void bprintf(const char *fmt, ...) {
    char tmp[512];
    va_list ap;
    va_start(ap, fmt);
    int n = vsnprintf(tmp, sizeof tmp, fmt, ap);
    va_end(ap);
    if (n < 0) return;
    if (n >= (int)sizeof tmp) n = (int)sizeof tmp - 1;
    if (blen + n + 1 > bcap) {
        bcap = (blen + n + 1) * 2;
        buf = realloc(buf, bcap);
        if (!buf) { fprintf(stderr, "out of memory\n"); exit(1); }
    }
    memcpy(buf + blen, tmp, n);
    blen += n;
    buf[blen] = '\0';
}

static void emit_op(int dst, int a, int op, int b) {
    if (op == '/' || op == '%')
        bprintf("    if (mem[%d] == 0) { fprintf(stderr, \"runtime error: division by zero\\n\"); return 1; }\n", b);
    bprintf("    mem[%d] = mem[%d] %c mem[%d];   /* %s = %s %c %s */\n",
            dst, a, op, b, names[dst], names[a], op, names[b]);
}

void write_output(FILE *out) {
    fprintf(out, "/* Generated by QuadC compiler */\n");
    fprintf(out, "#include <stdio.h>\n\n");
    fprintf(out, "#define MEM_SIZE %d\n\n", nvars > 0 ? nvars : 1);
    fprintf(out, "/* Memory map:\n");
    for (int i = 0; i < nvars; i++)
        fprintf(out, " *   mem[%d] -> %s\n", i, names[i]);
    fprintf(out, " */\n");
    fprintf(out, "int mem[MEM_SIZE];\n\n");
    fprintf(out, "int main(void) {\n");
    if (buf) fwrite(buf, 1, blen, out);
    fprintf(out, "    return 0;\n}\n");
}

void init_body(void) { buf = NULL; blen = bcap = 0; }
int  stat_three(void) { return count3; }
int  stat_quad(void)  { return count4; }
int  stat_vars(void)  { return nvars; }
%}

%union {
    int   ival;
    char *sval;
}

%token <ival> NUMBER OPNAME OPSYM
%token <sval> IDENT
%token LOAD PRINT LPAREN RPAREN COMMA SEMI

%type <ival> operator

%%

program
    : /* empty */
    | program statement
    ;

statement
    : three_operand SEMI
    | quadruple SEMI
    | load_stmt SEMI
    | print_stmt SEMI
    | error SEMI            { yyerrok; }
    ;

/* Three operand:   ADD a, b, c;      ->  c = a + b */
three_operand
    : OPNAME IDENT COMMA IDENT COMMA IDENT
      {
          int a = addr_of($2), b = addr_of($4), c = addr_of($6);
          emit_op(c, a, $1, b);
          count3++;
          free($2); free($4); free($6);
      }
    ;

/* Quadruple:   (+, a, b, c);   ->  c = a + b     (op, arg1, arg2, result) */
quadruple
    : LPAREN operator COMMA IDENT COMMA IDENT COMMA IDENT RPAREN
      {
          int a = addr_of($4), b = addr_of($6), c = addr_of($8);
          emit_op(c, a, $2, b);
          count4++;
          free($4); free($6); free($8);
      }
    ;

operator
    : OPSYM   { $$ = $1; }
    | OPNAME  { $$ = $1; }
    ;

/* LOAD x, 10;   -> mem[x] = 10 */
load_stmt
    : LOAD IDENT COMMA NUMBER
      {
          int a = addr_of($2);
          bprintf("    mem[%d] = %d;   /* %s = %d */\n", a, $4, names[a], $4);
          free($2);
      }
    ;

/* PRINT x;   */
print_stmt
    : PRINT IDENT
      {
          int a = addr_of($2);
          bprintf("    printf(\"%s = %%d\\n\", mem[%d]);\n", names[a], a);
          free($2);
      }
    ;

%%

void yyerror(const char *s) {
    fprintf(stderr, "Line %d: %s\n", line_no, s);
}
